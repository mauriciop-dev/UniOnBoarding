# ProOnboarding API - environment variables template
# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local to git.

# AI providers (in fallback order: GEMINI -> GROQ -> DEEPSEEK -> BEDROCK)
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
# AWS Bedrock Nova (texto) - usa un "Bedrock API key" largo (ABSK...) como Bearer
AWS_BEDROCK_API_KEY=ABSK_your_bedrock_key_here
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# TTS cloud (L2) para el endpoint /api/tts (Deepgram por defecto)
DEEPGRAM_API_KEY=your_deepgram_key_here

# InsForge backend (cache + future features)
INSFORGE_URL=https://your-app.region.insforge.app
INSFORGE_API_KEY=ik_your_project_key
INSFORGE_ANON_KEY=eyJ...
